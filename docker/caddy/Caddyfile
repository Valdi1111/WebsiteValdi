# Development Caddyfile: same layout as the one scripts/setup-server.sh writes on the server,
# served by the Mercure binary (Caddy + the Mercure module) of the dunglas/mercure image.
{
	# Caddy's internal CA instead of Let's Encrypt (local domain)
	local_certs
	default_sni {$DEV_DOMAIN}
	# HTTPS on the same port inside and outside the container, so that redirects and origins carry it
	https_port {$HTTPS_PORT}
}

# 1. Mercure hub
mercure.{$DEV_DOMAIN} {
	log {
		format filter {
			fields {
				request>uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	encode zstd gzip

	mercure {
		protocol_version_compatibility 8
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY} HS256
		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} HS256

		# Both forms: the browser omits the port when HTTPS_PORT is 443
		cors_origins https://{$DEV_DOMAIN} https://{$DEV_DOMAIN}:{$HTTPS_PORT} https://anime.{$DEV_DOMAIN} https://anime.{$DEV_DOMAIN}:{$HTTPS_PORT} https://books.{$DEV_DOMAIN} https://books.{$DEV_DOMAIN}:{$HTTPS_PORT} https://games.{$DEV_DOMAIN} https://games.{$DEV_DOMAIN}:{$HTTPS_PORT} https://passwords.{$DEV_DOMAIN} https://passwords.{$DEV_DOMAIN}:{$HTTPS_PORT} https://videos.{$DEV_DOMAIN} https://videos.{$DEV_DOMAIN}:{$HTTPS_PORT}
		publish_origins https://{$DEV_DOMAIN} https://{$DEV_DOMAIN}:{$HTTPS_PORT} https://anime.{$DEV_DOMAIN} https://anime.{$DEV_DOMAIN}:{$HTTPS_PORT} https://books.{$DEV_DOMAIN} https://books.{$DEV_DOMAIN}:{$HTTPS_PORT} https://games.{$DEV_DOMAIN} https://games.{$DEV_DOMAIN}:{$HTTPS_PORT} https://passwords.{$DEV_DOMAIN} https://passwords.{$DEV_DOMAIN}:{$HTTPS_PORT} https://videos.{$DEV_DOMAIN} https://videos.{$DEV_DOMAIN}:{$HTTPS_PORT}
	}

	respond /healthz 200
	respond "Not Found" 404
}

# Internal address PHP publishes to (MERCURE_URL=http://mercure/.well-known/mercure).
# It forwards to the hub above: listing http://mercure in the same block would start a second,
# separate hub on port 80 (Mercure 1.x refuses it), and the browsers would never get the updates.
http://mercure {
	reverse_proxy https://127.0.0.1:{$HTTPS_PORT} {
		header_up Host mercure.{$DEV_DOMAIN}
		transport http {
			tls_server_name mercure.{$DEV_DOMAIN}
			# Loopback to Caddy's own internal CA
			tls_insecure_skip_verify
		}
	}
}

# 2. Symfony application and subdomains (PHP runs in the php-fpm container, same project path)
{$DEV_DOMAIN}, anime.{$DEV_DOMAIN}, books.{$DEV_DOMAIN}, games.{$DEV_DOMAIN}, passwords.{$DEV_DOMAIN}, videos.{$DEV_DOMAIN} {
	root * /var/www/html/public

	encode zstd gzip
	file_server

	php_fastcgi php-fpm:9000 {
		try_files {path} index.php
		env X_SENDFILE_TYPE X-Sendfile
		resolve_root_symlink
	}

	@phpFile {
		path *.php*
	}
	error @phpFile "Not found" 404
}
