{% extends '@Core/security/auth_page.html.twig' %}

{% block title %}Forgot password{% endblock %}

{# errors: of the form (CSRF), and why a reset link did not work #}
{% set page = 'forgot-password' %}
{% set props = {
    action: path('core_forgot_password_request'),
    csrf: form._token is defined ? {name: form._token.vars.full_name, value: form._token.vars.value} : null,
    email: {
        name: form.email.vars.full_name,
        value: form.email.vars.value,
        errors: form.email.vars.errors|map(e => e.message),
    },
    errors: form.vars.errors|map(e => e.message)|merge(app.flashes(constant('App\\CoreBundle\\Controller\\ResetPasswordController::FLASH_REQUEST_ERROR'))),
    loginPath: path('core_login'),
} %}
