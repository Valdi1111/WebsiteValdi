{# Context: changed_at, forgot_password_url (UserPasswordManager) #}
{% extends '@Core/email/layout.html.twig' %}

{% block title %}Your password has been changed{% endblock %}

{% block content %}
    <h1>Your password has been changed</h1>
    <p>The password of your account was changed on {{ changed_at|date('j F Y \\a\\t H:i T') }}. The other devices have been logged out.</p>
    <p>If it was not you, choose a new password right away:</p>
    <p><a class="button" href="{{ forgot_password_url }}">Reset your password</a></p>
    <p class="muted">If the button does not work, open this address in your browser:<br><a class="link" href="{{ forgot_password_url }}">{{ forgot_password_url }}</a></p>
{% endblock %}
