{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('login') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('login') }}
{% endblock %}

{% block body %}
    <div id="react-login-app"
         data-props="{{ {
             csrfToken: csrf_token('authenticate'),
             lastUsername: last_username,
             error: error ? error.messageKey|trans(error.messageData, 'security') : null,
             checkPath: path('core_login'),
             imageUrl: asset('build/images/core-login.svg')
         }|json_encode|e('html_attr') }}">
    </div>
{% endblock %}
