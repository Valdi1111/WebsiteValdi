# Local configuration of website-deploy.sh (not versioned).
#
# On the server: /var/www/website-valdi-deploy/website-deploy.env, next to website-deploy.sh, in a folder owned by
# the deploy user. Copy this file there and adjust it.
# The script sources it with bash, so use plain VAR="value" lines. Another file can be used with
#   DEPLOY_ENV_FILE=/path/to/file /var/www/website-valdi-deploy/website-deploy.sh

# Project checkout (must contain .git)
APP_DIR="/var/www/valdi.ovh"

# Executable database backup script, run before every deploy
BACKUP_SCRIPT="/var/www/mysql-backup.sh"

# PHP-FPM service to reload to flush OPcache (that step is commented out in the script)
PHP_FPM_SERVICE="php8.5-fpm"

# Optional values, shown with their defaults
#NODE_SERVICES_DIR="node-services"
#SUPERVISOR_NODE_SERVICE="website-valdi:website-node-services"
#GIT_BRANCH="main"
