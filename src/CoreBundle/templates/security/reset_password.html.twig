{% extends '@Core/security/auth_page.html.twig' %}

{% block title %}Choose a new password{% endblock %}

{#
    email: for the password managers, which save the new password with the account.
    password.errors: the rules of NewPassword and the "do not match" error land on the repeated field.
#}
{% set password = form.plainPassword %}
{% set page = 'reset-password' %}
{% set props = {
    action: path('core_reset_password'),
    csrf: form._token is defined ? {name: form._token.vars.full_name, value: form._token.vars.value} : null,
    email: email,
    password: {
        name: password.first.vars.full_name,
        errors: password.vars.errors|map(e => e.message)|merge(password.first.vars.errors|map(e => e.message)),
    },
    confirmation: {
        name: password.second.vars.full_name,
        errors: password.second.vars.errors|map(e => e.message),
    },
    errors: form.vars.errors|map(e => e.message),
    minLength: constant('App\\CoreBundle\\Validator\\NewPassword::MIN_LENGTH'),
    loginPath: path('core_login'),
} %}
