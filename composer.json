{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-openssl": "*",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "dragonmantank/cron-expression": "^3.6",
        "elephantio/elephant.io": "^5.3",
        "erusev/parsedown": "^1.8",
        "kiwilan/php-ebook": "^3.0",
        "liip/imagine-bundle": "^2.18",
        "norkunas/youtube-dl-php": "2.*",
        "oneup/flysystem-bundle": "^4.14",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/asset": "8.1.*",
        "symfony/browser-kit": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/discord-notifier": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dom-crawler": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/finder": "8.1.*",
        "symfony/flex": "^2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mercure-bundle": "^0.4.2",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/notifier": "8.1.*",
        "symfony/object-mapper": "8.1.*",
        "symfony/password-hasher": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/telegram-notifier": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/webhook": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.0",
        "twig/twig": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\CoreBundle\\": "src/CoreBundle/src/",
            "App\\AnimeBundle\\": "src/AnimeBundle/src/",
            "App\\BooksBundle\\": "src/BooksBundle/src/",
            "App\\HoyoverseBundle\\": "src/HoyoverseBundle/src/",
            "App\\PasswordsBundle\\": "src/PasswordsBundle/src/",
            "App\\VideosBundle\\": "src/VideosBundle/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\CoreBundle\\Tests\\": "src/CoreBundle/tests/",
            "App\\AnimeBundle\\Tests\\": "src/AnimeBundle/tests/",
            "App\\BooksBundle\\Tests\\": "src/BooksBundle/tests/",
            "App\\HoyoverseBundle\\Tests\\": "src/HoyoverseBundle/tests/",
            "App\\PasswordsBundle\\Tests\\": "src/PasswordsBundle/tests/",
            "App\\VideosBundle\\Tests\\": "src/VideosBundle/tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/phpunit-bridge": "8.1.*",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    }
}
