{# Context: reset_url, expires_in (PasswordResetLinkSender) #}
{% extends '@Core/email/layout.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block content %}
    <h1>Reset your password</h1>
    <p>Someone, hopefully you, asked to reset the password of your account. Choose a new one from this link, which works once and expires in {{ expires_in }}:</p>
    <p><a class="button" href="{{ reset_url }}">Choose a new password</a></p>
    <p class="muted">If the button does not work, open this address in your browser:<br><a class="link" href="{{ reset_url }}">{{ reset_url }}</a></p>
    <p>If you did not ask for it, ignore this email: your password stays the same.</p>
{% endblock %}
