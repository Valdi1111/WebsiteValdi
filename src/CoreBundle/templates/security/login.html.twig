{% extends '@Core/security/auth_page.html.twig' %}

{% block title %}Login{% endblock %}

{# notice: e.g. after a password reset. Read once: "?:" would call app.flashes() twice, and the second call finds the flash consumed #}
{% set notice = app.flashes(constant('App\\CoreBundle\\Controller\\ResetPasswordController::FLASH_LOGIN_NOTICE'))|first %}
{% set page = 'login' %}
{% set props = {
    csrfToken: csrf_token('authenticate'),
    lastUsername: last_username,
    error: error ? error.messageKey|trans(error.messageData, 'security') : null,
    checkPath: path('core_login'),
    forgotPasswordPath: path('core_forgot_password_request'),
    notice: notice ?: null,
} %}
